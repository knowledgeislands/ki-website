---
pagination:
  data: tools
  size: 1
  alias: tool
permalink: "/tooling/{{ tool.slug }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ tool.name | safe }}"
  description: "{{ tool.tagline | safe }} Install it with Homebrew or the stable installer endpoint, and read the source repository for the exact release contract."
---

{% from "macros/icons.njk" import kiIcon %}

<section class="section-navy hero-section hero-section-standard">
  <div class="page-container" style="max-width: 64rem;">
    <p class="overline-gold">Tooling / <code>{{ tool.name }}</code></p>
    <h1 class="heading-display-light" style="font-size: clamp(2.25rem, 4vw, 3.25rem); margin-bottom: 1.25rem; max-width: 22ch;">{{ tool.tagline }}</h1>
    <p style="font-size: 1.125rem; color: rgb(245 239 224 / 75%); max-width: 54ch; line-height: 1.7;">{{ tool.description }}</p>
    <p style="margin-top: 1.5rem; font-size: 0.9375rem; color: rgb(245 239 224 / 60%);">Currently published as <code>{{ tool.version }}</code> · {{ tool.maturity }}</p>
  </div>
</section>

<section class="section-parchment section-pad">
  <div class="page-container" style="max-width: 64rem;">
    <div class="grid-2col" style="gap: 3rem; align-items: start;">
      <div class="prose-ki" style="max-width: none;">
        <p class="overline">Install</p>
        {% if tool.formula %}
        <h2>Prefer Homebrew.</h2>
        <p>The <a href="https://github.com/knowledgeislands/homebrew-tap">Knowledge Islands tap</a> packages <code>{{ tool.name }}</code>, so Homebrew owns upgrades and removal. Naming the tap in the argument taps it implicitly.</p>
        <pre style="overflow-x: auto; padding: 1rem; border-radius: var(--radius-md); background: var(--color-navy); color: var(--color-parchment); font-size: 0.8125rem;"><code>brew install knowledgeislands/tap/{{ tool.formula }}</code></pre>
        <h2>Or use the stable installer endpoint.</h2>
        {% else %}
        <h2>Use the stable installer endpoint.</h2>
        {% endif %}
        <p>The URL below is this site's stable machine route. It redirects to the installer published at <code>{{ tool.version }}</code> in <a href="{{ tool.repository }}">the source repository</a>, which owns the installer's behaviour and any signature or checksum verification it performs.</p>
        <pre style="overflow-x: auto; padding: 1rem; border-radius: var(--radius-md); background: var(--color-navy); color: var(--color-parchment); font-size: 0.8125rem;"><code>curl -fsSL {{ site.url }}/install/{{ tool.slug }} | sh</code></pre>
      </div>

      <aside class="card-ki">
        <div class="symbol-circle symbol-circle-{{ tool.accent }}">{{ kiIcon(tool.icon, 22) }}</div>
        <h2 style="font-size: 1.125rem; margin-bottom: 0.75rem;"><code>{{ tool.name }}</code> in detail.</h2>
        <p class="text-muted" style="font-size: 0.9375rem;">The source repository is the authority for this tool's commands, releases and artefacts. This page intentionally does not reproduce its executable contract.</p>
        <p style="margin: 0.75rem 0 0;"><a href="{{ tool.manual }}">Read the manual</a></p>
        <p style="margin: 0.375rem 0 0;"><a href="{{ tool.changelog }}">Release history</a></p>
        <p style="margin: 0.375rem 0 0;"><a href="{{ tool.repository }}">Open the repository</a></p>
      </aside>
    </div>
  </div>
</section>

<section class="section-mist section-pad">
  <div class="page-container" style="max-width: 64rem;">
    <div class="prose-ki" style="max-width: none;">
      <p class="overline">Other tools</p>
      <h2>The rest of the released set.</h2>
      <ul>
        {%- for other in tools %}
          {%- if other.slug != tool.slug %}
        <li><a href="/tooling/{{ other.slug }}/"><code>{{ other.name }}</code></a> — {{ other.tagline }}</li>
          {%- endif %}
        {%- endfor %}
      </ul>
      <p>Every entry above is declared in one website-owned registry, so its page, its <code>/install/</code> endpoint and its advertised version always move together.</p>
    </div>
  </div>
</section>
