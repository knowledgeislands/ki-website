// Directory data for the KI Agentic Harness project's guides, inherited by every Markdown page beside it.
//
// A guide is bound to its project by where it lives rather than by a line each page has to
// remember: `project` keys the collection `project.njk` renders its Guides section from, and
// `layout` gives the page the prose chrome — the measure, the styling, and the provenance footer.
//
// The directory name is the project's `slug` in `src/_data/projects.json5`, and `verify:guides`
// checks that this file agrees with it, so a renamed slug fails the build rather than the link.
{
  layout: 'layouts/page.njk',
  section: 'ki-agentic-harness'
}
