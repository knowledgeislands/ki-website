{
  "name": "@knowledgeislands/ki-site",
  "version": "1.0.0",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.5",
    "json5": "^2.2.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.129.0"
  },
  "private": true,
  "scripts": {
    "build": "bun node_modules/@11ty/eleventy/cmd.cjs --config=eleventy.config.ts && bun run verify:routes && bun run verify:projects && bun run verify:guidance && bun run verify:guides && bun run verify:reachable && bun run verify:prose",
    "clean": "rm -rf dist .wrangler",
    "deploy": "bunx wrangler deploy",
    "ki:site:dev": "concurrently --kill-others-on-fail --names css,11ty --prefix-colors cyan,yellow \"bun run ki:site:dev:css\" \"bun run ki:site:dev:serve\"",
    "ki:site:dev:css": "bunx tailwindcss -i src/assets/css/main.css -o ./dist/assets/css/main.css --watch",
    "ki:site:dev:serve": "bun node_modules/@11ty/eleventy/cmd.cjs --config=eleventy.config.ts --serve --port 3000",
    "preview": "bun run build && bunx wrangler dev",
    "sync:cli": "bun scripts/sync-cli-commands.ts",
    "sync:skills": "bun scripts/sync-skill-catalogue.ts",
    "upload": "bunx wrangler versions upload",
    "verify:guidance": "bun scripts/verify-guidance-sources.ts",
    "verify:guides": "bun scripts/verify-guides.ts",
    "verify:projects": "bun scripts/verify-projects.ts",
    "verify:prose": "bun scripts/verify-prose-coverage.ts",
    "verify:reachable": "bun scripts/verify-guidance-reachable.ts",
    "verify:routes": "bun scripts/verify-tool-routes.ts"
  },
  "type": "module"
}
