// Website-owned registry of released Knowledge Islands command-line tools.
//
// This file is a discoverability and indirection declaration, not an artefact
// host. Each tool repository remains the authority for its executable
// behaviour, release artefacts, checksums and installer script; the Homebrew
// tap remains the authority for its formula. The website only promises that
// `/tooling/<slug>/` describes the tool and that `/install/<slug>` redirects to
// the installer published at the declared immutable release tag.
//
// Fields
//   slug        route segment for `/tooling/<slug>/` and `/install/<slug>`
//   name        the executable as a user types it
//   tagline     one short sentence for cards and page headers
//   description a fuller paragraph for the product page
//   repository  canonical source repository
//   version     published release this registry currently advertises
//   maturity    stable | preview | experimental (see docs/guides/tool-routes.md)
//   formula     Homebrew formula in knowledgeislands/tap, or null when untapped
//   installer   immutable installer target the machine route redirects to
//   manual      human manual at the declared version
//   changelog   release history at the declared version
//   icon        KI symbol name from src/_includes/macros/icons.njk
//   accent      symbol-circle accent: gold | teal | forest
//
// Adding or advancing an entry is a release follow-up performed by the tool's
// repository; `bun run ki:site:verify` gates the declaration before deployment.
[
  {
    slug: 'ki',
    name: 'ki',
    tagline: 'The Knowledge Islands command-line interface.',
    description:
      'Installs verified compatible harnesses, activates skills in explicit scopes, and hosts the native repository operations that govern a Knowledge Islands checkout.',
    repository: 'https://github.com/knowledgeislands/tools-ki',
    version: 'v0.3.6',
    maturity: 'preview',
    formula: 'ki',
    installer: 'https://raw.githubusercontent.com/knowledgeislands/tools-ki/v0.3.6/install.sh',
    manual: 'https://github.com/knowledgeislands/tools-ki/blob/v0.3.6/README.md',
    changelog: 'https://github.com/knowledgeislands/tools-ki/blob/v0.3.6/CHANGELOG.md',
    icon: 'anchor',
    accent: 'gold'
  },
  {
    slug: 'mgit',
    name: 'mgit',
    tagline: 'Run commands across many Git repositories at once.',
    description:
      'Sweeps a directory of checkouts and runs the same Git or shell command across all of them, reporting per-repository results so a wide working set stays legible.',
    repository: 'https://github.com/knowledgeislands/tools-mgit',
    version: 'v0.12.0',
    maturity: 'preview',
    formula: 'mgit',
    installer: 'https://raw.githubusercontent.com/knowledgeislands/tools-mgit/v0.12.0/install.sh',
    manual: 'https://github.com/knowledgeislands/tools-mgit/blob/v0.12.0/README.md',
    changelog: 'https://github.com/knowledgeislands/tools-mgit/blob/v0.12.0/CHANGELOG.md',
    icon: 'route',
    accent: 'teal'
  },
  {
    slug: 'git-almanac',
    name: 'git-almanac',
    tagline: "Inspect one local Git repository's calendars, authors and reports offline.",
    description:
      'Reads a single checkout and reports its calendars, authors, contributors and activity without contacting a forge, so repository history can be reviewed offline.',
    repository: 'https://github.com/knowledgeislands/tools-git-almanac',
    version: 'v0.1.0',
    maturity: 'experimental',
    formula: 'git-almanac',
    installer: 'https://raw.githubusercontent.com/knowledgeislands/tools-git-almanac/v0.1.0/install.sh',
    manual: 'https://github.com/knowledgeislands/tools-git-almanac/blob/v0.1.0/README.md',
    changelog: 'https://github.com/knowledgeislands/tools-git-almanac/blob/v0.1.0/CHANGELOG.md',
    icon: 'book',
    accent: 'forest'
  },
  {
    slug: 'rig',
    name: 'rig',
    tagline: "A declarative description manager for a person's working setup.",
    description:
      'Records preferred tools, what they are for and why they belong, resolves named profiles for machines and roles, and compares declared intent against what each provider actually observes.',
    repository: 'https://github.com/knowledgeislands/tools-rig',
    version: 'v0.1.0',
    maturity: 'experimental',
    formula: 'rig',
    installer: 'https://raw.githubusercontent.com/knowledgeislands/tools-rig/v0.1.0/install.sh',
    manual: 'https://github.com/knowledgeislands/tools-rig/blob/v0.1.0/README.md',
    changelog: 'https://github.com/knowledgeislands/tools-rig/blob/v0.1.0/CHANGELOG.md',
    icon: 'compass',
    accent: 'gold'
  }
]
