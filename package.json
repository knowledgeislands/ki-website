{
  "name": "@knowledgeislands/ki-website",
  "description": "Public-facing portal for Knowledge Islands — shares project knowledge and links out to key resources.",
  "version": "1.0.0",
  "author": "kris@kris.me.uk",
  "bugs": {
    "url": "https://github.com/knowledgeislands/ki-website/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "rumdl": "^0.2.74",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/knowledgeislands/ki-website#readme",
  "keywords": [
    "arcadia",
    "eleventy",
    "knowledge-islands",
    "tailwindcss",
    "website"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "bunx @biomejs/biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "bunx rumdl check --fix"
    ]
  },
  "packageManager": "bun@1.4.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/ki-website.git"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "ki:deps:update": "bun update --latest",
    "ki:site:build": "bun run --cwd apps/site build",
    "ki:site:clean": "bun run --cwd apps/site clean",
    "ki:site:deploy": "bun run --cwd apps/site deploy",
    "ki:site:dev": "bun run --cwd apps/site ki:site:dev",
    "ki:site:preview": "bun run --cwd apps/site preview",
    "ki:site:upload": "bun run --cwd apps/site upload",
    "prepare": "husky",
    "self:typecheck": "bunx tsc --noEmit && turbo run typecheck",
    "test": "turbo run test"
  },
  "type": "module",
  "workspaces": [
    "apps/*"
  ]
}
